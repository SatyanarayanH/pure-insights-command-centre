# Copy to .env only if you want to change a default. The app runs with none of these set.

# --- Server -------------------------------------------------------------------------------
# API_PORT=4000            # API port. (PORT is honoured only when NODE_ENV=production.)
# LOG_LEVEL=info           # fatal | error | warn | info | debug | trace | silent
# CORS_ORIGIN=http://localhost:5173
# FORCE_HTTPS=false        # true behind TLS: Secure cookies + upgrade-insecure-requests

# --- Security -----------------------------------------------------------------------------
# Required in production unless DEMO_MODE=true. At least 32 characters.
# JWT_SECRET=
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_DAYS=7

# --- Demo mode ----------------------------------------------------------------------------
# Seeds the persona accounts and enables one-click sign-in and incident injection.
# Turn off for anything that is not a demonstration.
DEMO_MODE=true
# Password shared by the seeded demo accounts (admin@company.com, finops@company.com,
# viewer@company.com and user_1..user_14@company.com). Test value for this app only.
DEMO_PASSWORD=command-centre-demo
# Key the portal's telemetry emitter sends as X-API-Key to POST /api/v1/telemetry.
INGEST_API_KEY=demo-ingest-key-change-me

# --- Telemetry simulator ------------------------------------------------------------------
# SIMULATOR_ENABLED=true
# SIMULATOR_INTERVAL_MS=2500

# --- Snowflake validation run (npm run sql:snowflake) ---------------------------------------
# Only needed to execute the SQL suite on a real Snowflake account. See sql/README.md.
# SNOWFLAKE_ACCOUNT=           # e.g. xy12345.eu-west-1  (organisation-account also works)
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=          # or SNOWFLAKE_TOKEN (programmatic access token)
# SNOWFLAKE_TOKEN=
# SNOWFLAKE_PRIVATE_KEY_PATH=  # or key-pair authentication
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=PURE_INSIGHTS_SIM
# SNOWFLAKE_ROLE=
