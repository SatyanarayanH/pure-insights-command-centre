            "type": {
              "type": "string",
              "const": "error"
            },
            "ts": {
              "type": "string",
              "description": "ISO-8601 timestamp (UTC)",
              "format": "date-time"
            },
            "data": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "v",
            "id",
            "type",
            "ts",
            "data"
          ],
          "additionalProperties": false
        },
        "x-topic": null
      },
      "clientPing": {
        "name": "ping",
        "title": "Heartbeat",
        "summary": "Heartbeat",
        "description": "Send at least every `heartbeatIntervalMs`. The server closes connections that stay silent for twice that.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ping"
            },
            "ts": {
              "type": "number"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "clientSubscribe": {
        "name": "subscribe",
        "title": "Add topics",
        "summary": "Add topics",
        "description": "Adds topics to the connection. Row-level security still applies to everything delivered.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "subscribe"
            },
            "topics": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Topic"
              }
            }
          },
          "required": [
            "type",
            "topics"
          ],
          "additionalProperties": false
        }
      },
      "clientUnsubscribe": {
        "name": "unsubscribe",
        "title": "Remove topics",
        "summary": "Remove topics",
        "description": "Stops delivery for the given topics.",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unsubscribe"
            },
            "topics": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Topic"
              }
            }
          },
          "required": [
            "type",
            "topics"
          ],
          "additionalProperties": false
        }
      }
    },
    "schemas": {
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "description": "`<ruleId>:<reportId>`. One open alert per fingerprint."
          },
          "ruleId": {
            "$ref": "#/components/schemas/AlertRuleId"
          },
          "ruleName": {
            "type": "string"
          },
          "reportId": {
            "type": "string",
            "pattern": "^RPT_\\d{1,6}$",
            "description": "Report identifier",
            "example": "RPT_203"
          },
          "reportName": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/AlertStatus"
          },
          "message": {
            "type": "string"
          },
          "value": {
            "description": "Latest observed value (seconds for latency, streak length for refresh).",
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurrences": {
            "type": "integer",
            "description": "Breaching observations folded into this alert."
          },
          "reopenCount": {
            "type": "integer"
          },
          "isFlapping": {
            "type": "boolean"
          },
          "healthyStreak": {
            "type": "integer",
            "description": "Consecutive healthy observations since the last breach. Above 0 on an open alert means it is recovering: the latest reading was fine but the alert has not cleared yet."
          },
          "resolveAfter": {
            "type": "integer",
            "description": "Healthy observations in a row needed before this alert resolves."
          },
          "firstSeenAt": {
            "type": "string",
            "description": "ISO-8601 timestamp (UTC)",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "description": "ISO-8601 timestamp (UTC)",
            "format": "date-time"
          },
          "resolvedAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO-8601 timestamp (UTC)",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "acknowledgedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "acknowledgedAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO-8601 timestamp (UTC)",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "ackNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "snoozedUntil": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO-8601 timestamp (UTC)",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "routing": {
            "$ref": "#/components/schemas/AlertRouting"
          },
          "source": {
            "$ref": "#/components/schemas/AlertSource"
          }
        },
        "required": [
          "id",
          "fingerprint",
          "ruleId",
          "ruleName",
          "reportId",
          "reportName",
          "severity",
          "status",
          "message",
          "value",
          "threshold",
          "unit",
          "occurrences",
          "reopenCount",
          "isFlapping",
          "healthyStreak",
          "resolveAfter",
          "firstSeenAt",
          "lastSeenAt",
          "resolvedAt",
          "acknowledgedBy",
          "acknowledgedAt",
          "ackNote",
          "snoozedUntil",
          "routing",
          "source"
        ],
        "additionalProperties": false
      },
      "AlertRouting": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "owner",
              "admins"
            ]
          },
          "ownerEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "escalated": {
            "type": "boolean",
            "description": "True when the report has no owner, so the alert went to platform admins."
          }
        },
        "required": [
          "kind",
          "ownerEmail",
          "escalated"
        ],
        "additionalProperties": false
      },
      "AlertRuleId": {
        "type": "string",
        "enum": [
          "latency",
          "refresh_failure",
          "refresh_unknown",
          "invalid_telemetry"
        ]
      },
      "AlertSource": {
        "type": "string",
        "enum": [
          "backfill",
          "live",
          "injected",
          "api"
        ]
      },
      "AlertStatus": {
        "type": "string",
        "enum": [
          "firing",
          "acknowledged",
          "resolved"
        ],
        "description": "firing: condition holds, nobody has taken it. acknowledged: condition holds, someone owns it. resolved: condition cleared."
      },
      "RefreshStatus": {
        "type": "string",
        "enum": [
          "SUCCESS",
          "FAILED",
          "TIMED_OUT",
          "UNKNOWN"
        ],
        "description": "Outcome of the last automated refresh. UNKNOWN means the portal reported no outcome."
      },
      "Severity": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "high",
          "critical"
        ]
      },
      "Topic": {
        "type": "string",
        "enum": [
          "alerts",
          "reports",
          "telemetry",
          "system"
        ],
        "description": "alerts: alert lifecycle. reports: ownership changes. telemetry: every observation (high volume, opt-in). system: operational notices."
      }
    }
  }
}
