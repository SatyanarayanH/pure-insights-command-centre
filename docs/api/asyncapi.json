{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Pure Insights Command Centre real-time protocol",
    "version": "1.0.0+protocol.1",
    "description": "Operational events pushed to browsers: alert lifecycle, ownership changes and raw telemetry.\n\nTwo transports carry the same events in the same envelope `{ v, id, type, ts, data }`:\n- **WebSocket** at `/ws`: bidirectional; the client can ping and change its topic subscriptions.\n- **Server-Sent Events** at `/api/v1/stream`: server-to-client only; for networks or proxies that block WebSocket.\n\n**Authentication.** Browsers cannot set an Authorization header on either transport, so the client first calls\n`POST /api/v1/realtime/ticket` with its bearer token and opens the stream with `?ticket=`. A ticket works once and expires in 30 seconds.\n\n**Authorisation.** Applied per event at delivery: a Report Owner only receives events for reports they own, and callers without `pii:read` receive masked email addresses. The rules are the same functions the REST API uses.\n\n**Delivery.** At-least-once within the replay buffer. Each topic event has a monotonically increasing `id`; reconnect with `lastEventId` to receive what was missed. If the gap has left the buffer the server sends `replay.gap` and the client refetches state over REST. Handlers should be idempotent on `id`.\n\n**Liveness.** The server sends a protocol-level ping every heartbeat interval and closes connections that do not answer. Clients may also send an application `ping` to measure round-trip time.\n\n**Close codes.** `4401` Missing, expired or already-used ticket · `4408` No heartbeat received · `4429` Client is not reading fast enough · `4430` Too many client messages · `1001` Server is shutting down."
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "host": "localhost:4000",
      "protocol": "ws",
      "description": "Local development"
    },
    "production": {
      "host": "command-centre.example.com",
      "protocol": "wss",
      "description": "Behind TLS"
    }
  },
  "channels": {
    "events": {
      "address": "/ws",
      "title": "WebSocket event stream",
      "description": "Server events, plus client control messages.",
      "messages": {
        "connectionReady": {
          "$ref": "#/components/messages/connectionReady"
        },
        "alertFired": {
          "$ref": "#/components/messages/alertFired"
        },
        "alertUpdated": {
          "$ref": "#/components/messages/alertUpdated"
        },
        "alertResolved": {
          "$ref": "#/components/messages/alertResolved"
        },
        "telemetryObserved": {
          "$ref": "#/components/messages/telemetryObserved"
        },
        "reportOwnerChanged": {
          "$ref": "#/components/messages/reportOwnerChanged"
        },
        "systemNotice": {
          "$ref": "#/components/messages/systemNotice"
        },
        "replayGap": {
          "$ref": "#/components/messages/replayGap"
        },
        "subscribed": {
          "$ref": "#/components/messages/subscribed"
        },
        "pong": {
          "$ref": "#/components/messages/pong"
        },
        "error": {
          "$ref": "#/components/messages/error"
        },
        "clientPing": {
          "$ref": "#/components/messages/clientPing"
        },
        "clientSubscribe": {
          "$ref": "#/components/messages/clientSubscribe"
        },
        "clientUnsubscribe": {
          "$ref": "#/components/messages/clientUnsubscribe"
        }
      },
      "bindings": {
        "ws": {
          "query": {
            "type": "object",
            "required": [
              "ticket"
            ],
            "properties": {
              "ticket": {
                "type": "string",
                "description": "Single-use ticket from `POST /api/v1/realtime/ticket`. Valid for 30 seconds."
              },
              "topics": {
                "type": "string",
                "description": "Comma-separated topics. One or more of: alerts, reports, telemetry, system. Default: alerts,reports,system."
              },
              "lastEventId": {
                "type": "integer",
                "description": "Resume point: the server replays every buffered event with a greater id before sending live events."
              }
            }
          },
          "bindingVersion": "0.1.0"
        }
      }
    },
    "eventsSse": {
      "address": "/api/v1/stream",
      "title": "Server-Sent Events stream",
      "description": "Same server events as the WebSocket channel. Each is sent as `event: <type>`, `id: <id>` and `data: <envelope JSON>`. The browser's EventSource resends `Last-Event-ID` on reconnect, which the server honours exactly like `lastEventId`.",
      "messages": {
        "connectionReady": {
          "$ref": "#/components/messages/connectionReady"
        },
        "alertFired": {
          "$ref": "#/components/messages/alertFired"
        },
        "alertUpdated": {
          "$ref": "#/components/messages/alertUpdated"
        },
        "alertResolved": {
          "$ref": "#/components/messages/alertResolved"
        },
        "telemetryObserved": {
          "$ref": "#/components/messages/telemetryObserved"
        },
        "reportOwnerChanged": {
          "$ref": "#/components/messages/reportOwnerChanged"
        },
        "systemNotice": {
          "$ref": "#/components/messages/systemNotice"
        },
        "replayGap": {
          "$ref": "#/components/messages/replayGap"
        }
      },
      "bindings": {
        "http": {
          "method": "GET",
          "query": {
            "type": "object",
            "required": [
              "ticket"
            ],
            "properties": {
              "ticket": {
                "type": "string",
                "description": "Single-use ticket from `POST /api/v1/realtime/ticket`. Valid for 30 seconds."
              },
              "topics": {
                "type": "string",
                "description": "Comma-separated topics. One or more of: alerts, reports, telemetry, system. Default: alerts,reports,system."
              },
              "lastEventId": {
                "type": "integer",
                "description": "Resume point: the server replays every buffered event with a greater id before sending live events."
              }
            }
          },
          "bindingVersion": "0.3.0"
        }
      }
    }
  },
