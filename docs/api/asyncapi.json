                      "type": "null"
                    }
                  ]
                },
                "breach": {
                  "type": "boolean",
                  "description": "True when this observation violates at least one alert rule."
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "reportId",
                "observedAt",
                "loadTimeSec",
                "refreshStatus",
                "breach",
                "source"
