  "components": {
    "messages": {
      "connectionReady": {
        "name": "connection.ready",
        "title": "Handshake accepted",
        "summary": "Handshake accepted",
        "description": "First message on every connection. States who the server thinks you are and how many missed events follow.\n\nTopic: none (connection-scoped, id is 0, never replayed).",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "id": {
              "type": "integer"
            },
            "type": {
              "type": "string",
              "const": "connection.ready"
            },
            "ts": {
              "type": "string",
              "description": "ISO-8601 timestamp (UTC)",
              "format": "date-time"
            },
            "data": {
              "type": "object",
              "properties": {
                "connectionId": {
                  "type": "string"
                },
                "protocolVersion": {
                  "type": "number",
                  "const": 1
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "all",
                        "own"
                      ]
                    }
                  },
                  "required": [
                    "email",
                    "role",
                    "scope"
                  ],
                  "additionalProperties": false
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Topic"
                  }
                },
                "heartbeatIntervalMs": {
                  "type": "integer"
                },
                "streamId": {
                  "type": "string",
                  "description": "Identifies this run of the event stream. Event ids are only comparable within one stream; send it back with `lastEventId` when reconnecting."
                },
                "latestEventId": {
                  "type": "integer"
                },
                "resumedFrom": {
                  "description": "The id replay started after, or null if nothing was resumed (first connection, or a different stream).",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "replayed": {
                  "type": "integer",
                  "description": "Missed events about to be delivered after this message."
                }
              },
              "required": [
                "connectionId",
                "protocolVersion",
                "user",
                "topics",
                "heartbeatIntervalMs",
                "streamId",
                "latestEventId",
                "resumedFrom",
                "replayed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "v",
            "id",
            "type",
            "ts",
            "data"
          ],
          "additionalProperties": false
        },
        "x-topic": null
      },
